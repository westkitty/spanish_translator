  online: boolean;
  persisted: boolean | null;
  usage: number | null;
  quota: number | null;
  cachedEntries: number;
  transcriptionModelCached: boolean;
  translationModelCached: boolean;
  lastOfflineTest: number | null;
}

const TEST_KEY = 'dexterpreter-last-offline-test';
const ASR_HINTS = ['whisper-tiny', 'whisper-base', 'whisper-small'];
const MT_HINT = 'opus-mt-es-en';

export async function inspectOfflineReadiness(): Promise<OfflineReadinessReport> {
  const persisted = navigator.storage?.persisted ? await navigator.storage.persisted().catch(() => null) : null;
  const estimate = navigator.storage?.estimate ? await navigator.storage.estimate().catch(() => ({})) : {};
  let urls: string[] = [];
  if ('caches' in window) {
    for (const name of await caches.keys()) {
      const cache = await caches.open(name);
      urls.push(...(await cache.keys()).map((request) => request.url));
    }
  }
  const lower = urls.map((url) => url.toLowerCase());
  return {
    online: navigator.onLine,
    persisted,
    usage: typeof estimate.usage === 'number' ? estimate.usage : null,
    quota: typeof estimate.quota === 'number' ? estimate.quota : null,
    cachedEntries: urls.length,
    transcriptionModelCached: lower.some((url) => ASR_HINTS.some((hint) => url.includes(hint))),
    translationModelCached: lower.some((url) => url.includes(MT_HINT)),
    lastOfflineTest: Number(localStorage.getItem(TEST_KEY)) || null,
  };
}

export function recordOfflineTest(): void {
  if (navigator.onLine) throw new Error('Disconnect from the network before recording an offline test.');
  localStorage.setItem(TEST_KEY, String(Date.now()));
}

export async function requestPersistentStorage(): Promise<boolean | null> {
  if (!navigator.storage?.persist) return null;
  return navigator.storage.persist();
}
