 replacements. Disabled rules are not applied to future runs.</p></div></div>
        {rules.length === 0 ? <div className="empty-state empty-state--compact"><p>No managed corrections yet.</p></div> : <div className="dictionary-list">{rules.map((rule) => <div key={rule.id} className="dictionary-row">
          <label><input type="checkbox" checked={rule.enabled} onChange={(event) => commitRules(rules.map((item) => item.id === rule.id ? { ...item, enabled: event.target.checked } : item))} /><span><strong>{rule.from}</strong> → {rule.to}<small>{rule.scope === 'global' ? 'All projects' : 'One project'}</small></span></label>
          <button type="button" className="icon-button icon-button--danger" aria-label={`Remove correction ${rule.from}`} onClick={() => commitRules(rules.filter((item) => item.id !== rule.id))}><Trash2 aria-hidden="true" /></button>
        </div>)}</div>}
      </section>}

      {tab === 'diagnostics' && <section className="tool-section">
        <div className="section-heading"><Download aria-hidden="true" /><div><h2>Diagnostics export</h2><p>Creates a local JSON report with app, runtime, cache, and storage metadata. Transcript text and audio are excluded.</p></div></div>
        <button type="button" className="primary-button" onClick={() => void buildDiagnostics(projects).then((data) => saveTextFile(`dexterpreter-diagnostics-${Date.now()}.json`, 'application/json', JSON.stringify(data, null, 2)))}><Download aria-hidden="true" />Save diagnostics</button>
      </section>}
    </Modal>
  );
}
''')

