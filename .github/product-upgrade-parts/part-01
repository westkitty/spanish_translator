write('frontend/src/lib/projectBundle.ts', r'''import type { StoredProject } from './db';

interface ProjectBundleV1 {
  schema: 'dexterpreter-project';
  version: 1;
  exportedAt: string;
  project: Omit<StoredProject, 'audioBlob'> & { audio?: { type: string; base64: string } };
}

function bytesToBase64(bytes: Uint8Array): string {
  let binary = '';
  const chunk = 0x8000;
  for (let i = 0; i < bytes.length; i += chunk) binary += String.fromCharCode(...bytes.subarray(i, i + chunk));
  return btoa(binary);
}

function base64ToBytes(value: string): Uint8Array {
  const binary = atob(value);
  return Uint8Array.from(binary, (char) => char.charCodeAt(0));
}

export async function exportProjectBundle(project: StoredProject, includeAudio: boolean): Promise<string> {
  const { audioBlob, ...rest } = project;
  const audio = includeAudio && audioBlob.size > 0
    ? { type: audioBlob.type, base64: bytesToBase64(new Uint8Array(await audioBlob.arrayBuffer())) }
    : undefined;
  const bundle: ProjectBundleV1 = { schema: 'dexterpreter-project', version: 1, exportedAt: new Date().toISOString(), project: { ...rest, audio } };
  return JSON.stringify(bundle, null, 2);
}

export function importProjectBundle(text: string): StoredProject {
  const value = JSON.parse(text) as ProjectBundleV1;
  if (value.schema !== 'dexterpreter-project' || value.version !== 1 || !value.project?.id || !Array.isArray(value.project.words)) {
    throw new Error('This is not a supported Dexterpreter project bundle.');
  }
  const { audio, ...project } = value.project;
  const audioBlob = audio ? new Blob([base64ToBytes(audio.base64)], { type: audio.type }) : new Blob([], { type: 'application/x-dexterpreter-transcript-only' });
  return { ...project, id: `${project.id}-import-${Date.now()}`, name: `${project.name} (imported)`, audioBlob, updatedAt: Date.now() };
}
''')

